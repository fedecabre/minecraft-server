FROM eclipse-temurin:21-jdk-slim

WORKDIR /geyser

RUN apt-get update && apt-get install -y curl && rm -rf /var/lib/apt/lists/*

# Download latest Geyser standalone JAR
RUN curl -L https://download.geysermc.org/v2/projects/geyser/versions/latest/builds/latest/downloads/standalone -o geyser.jar

COPY config.yml .

EXPOSE 19132/udp
EXPOSE 19133/tcp

CMD ["java", "-Xmx512M", "-jar", "geyser.jar"]
